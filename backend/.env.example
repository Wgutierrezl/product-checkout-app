# App
NODE_ENV=development
PORT=3000

# Payment gateway (sandbox credentials go in backend/.env, never commit real values)
PAYMENT_GATEWAY_URL=https://sandbox.payment-gateway.example.com
PAYMENT_GATEWAY_PUBLIC_KEY=pub_test_replace_me
PAYMENT_GATEWAY_PRIVATE_KEY=prv_test_replace_me
PAYMENT_GATEWAY_INTEGRITY_SECRET=replace_me
PAYMENT_GATEWAY_EVENTS_SECRET=replace_me

# AWS / DynamoDB
AWS_REGION=us-east-1
DYNAMO_ENDPOINT=http://localhost:8000

# Fees (integer cents, COP)
BASE_FEE_CENTS=250000
DELIVERY_FEE_CENTS=800000

# Settlement
LAZY_POLL_THRESHOLD_MS=3000

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# Accounts (register/login) — HS256 JWT signing secret, ~1h expiry, no refresh.
# Required, minimum 32 characters (enforced by env.validation.ts). Any long
# random string works for local dev, e.g. `openssl rand -hex 32` (64 hex
# chars); in AWS this is fetched from SSM instead (see
# src/shared/config/ssm-bootstrap.ts) using 48 random bytes. Rotation is
# manual-only — rotating this value invalidates every previously-issued token.
ACCOUNTS_JWT_SECRET=local-dev-only-change-me-to-a-long-random-string-32-chars-min
