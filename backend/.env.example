# App
NODE_ENV=development
PORT=3000

# Payment gateway (sandbox credentials go in backend/.env, never commit real values)
PAYMENT_GATEWAY_URL=https://sandbox.payment-gateway.example.com
PAYMENT_GATEWAY_PUBLIC_KEY=pub_test_replace_me
PAYMENT_GATEWAY_PRIVATE_KEY=prv_test_replace_me
PAYMENT_GATEWAY_INTEGRITY_SECRET=replace_me
PAYMENT_GATEWAY_EVENTS_SECRET=replace_me

# AWS / DynamoDB
AWS_REGION=us-east-1
DYNAMO_ENDPOINT=http://localhost:8000

# Fees (integer cents, COP)
BASE_FEE_CENTS=250000
DELIVERY_FEE_CENTS=800000

# Settlement
LAZY_POLL_THRESHOLD_MS=3000

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=30
